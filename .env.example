# ==============================================================================
# YCCCI Mass Booking - Environment Configuration
# ==============================================================================

# Server Port (Render sets this automatically)
PORT=3000

# Recipient Email (defaults to youngchosenforchrist@gmail.com)
RECIPIENT_EMAIL=youngchosenforchrist@gmail.com

# ------------------------------------------------------------------------------
# RESEND CONFIGURATION (https://resend.com)
# ------------------------------------------------------------------------------
# 1. Sign up at https://resend.com
# 2. Get your API Key from https://resend.com/api-keys
# 3. Add this key in your Render Web Service Environment settings:
RESEND_API_KEY=re_your_api_key_here

# Sender Address:
# Before adding a verified custom domain, you can use Resend's testing address:
SENDER_EMAIL=YCCCI Memorial <onboarding@resend.dev>

# Once your domain is verified on Resend (e.g. youngandchosenforchrist.com):
# SENDER_EMAIL=YCCCI Memorial <intentions@youngandchosenforchrist.com>
