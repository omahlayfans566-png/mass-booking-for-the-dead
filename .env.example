# ==============================================================================
# YCCCI Mass Booking & Paystack Live Payment - Environment Configuration Template
# Copy this file to .env and fill in the values. Never commit .env to git.
# ==============================================================================

# Server Port (Render sets this automatically; leave as 3000 for local dev)
PORT=3000

# ------------------------------------------------------------------------------
# PAYSTACK CONFIGURATION (https://paystack.com/docs/)
# Get these from your Paystack Dashboard → Settings → API Keys & Webhooks
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# ------------------------------------------------------------------------------
# RECIPIENT EMAIL — Fixed destination for ALL Mass booking confirmations
# Every successful submission is delivered here. Never expose in frontend code.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=younganchoseforchrist@gmail.com
MASS_BOOKING_EMAIL=younganchoseforchrist@gmail.com
RECIPIENT_EMAIL=younganchoseforchrist@gmail.com

# ------------------------------------------------------------------------------
# EMAIL DELIVERY: BREVO SMTP (Primary — recommended)
#
# How to set up:
#   1. Log in at https://app.brevo.com
#   2. Go to: Account menu → SMTP & API → SMTP tab
#   3. Your SMTP credentials are shown there:
#        Login   = your Brevo account email (e.g. you@gmail.com)
#        Password = the SMTP key shown on that page (same as your API key)
#   4. Paste them below.
#
# Host: smtp-relay.brevo.com  |  Port: 587  |  Security: STARTTLS
# ------------------------------------------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email_here
BREVO_SMTP_PASS=your_brevo_smtp_password_or_api_key_here

# The "From" address shown on received emails.
# Note: Brevo allows sending from any verified sender.
# If you have NOT verified a custom domain, use your own verified email address.
SENDER_EMAIL=YCCCI Memorial <younganchoseforchrist@gmail.com>

# ------------------------------------------------------------------------------
# EMAIL DELIVERY: RESEND API (Optional alternative to Brevo)
# Leave blank if you are using Brevo above.
# Get a key at https://resend.com/api-keys
# Important: Resend requires a verified sender domain for production use.
#   The sandbox address (onboarding@resend.dev) can only send to your own
#   Resend-verified email — not to external addresses like Gmail.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
# SENDER_EMAIL=YCCCI Memorial <intentions@yourdomain.com>   # once domain is verified

# ------------------------------------------------------------------------------
# EMAIL DELIVERY: GMAIL APP PASSWORD (Legacy fallback — not recommended)
# Only use this if neither Brevo nor Resend is available.
# Requires a Google App Password (NOT your Google account password):
#   https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# GMAIL_USER=your_gmail_address@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# DEPLOYMENT FRONTEND URL
# Set this to your public website URL so Paystack redirects back correctly.
# Example: https://mass-booking.youngandchosenforchrist.com
# Leave blank on Render (it auto-detects from request headers).
# ------------------------------------------------------------------------------
FRONTEND_URL=
