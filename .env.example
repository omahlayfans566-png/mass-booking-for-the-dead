# ==============================================================================
# YCCCI Mass Booking & Paystack Live Payment - Environment Configuration Template
# ==============================================================================

# Server Port (Render sets this automatically)
PORT=3000

# ------------------------------------------------------------------------------
# PAYSTACK CONFIGURATION (https://paystack.com/docs/)
# Add these keys in your Render Web Service Environment settings:
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# ------------------------------------------------------------------------------
# RECIPIENT EMAIL (Designated parish administrator email)
# ------------------------------------------------------------------------------
MASS_BOOKING_EMAIL=youngchosenforchrist@gmail.com
RECIPIENT_EMAIL=youngchosenforchrist@gmail.com

# ------------------------------------------------------------------------------
# EMAIL DELIVERY PROVIDER: RESEND (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
SENDER_EMAIL=YCCCI Memorial <onboarding@resend.dev>
# Once custom domain is verified on Resend:
# SENDER_EMAIL=YCCCI Memorial <intentions@youngandchosenforchrist.com>

# ------------------------------------------------------------------------------
# ALTERNATIVE EMAIL: GMAIL / SMTP (Fallback if not using Resend)
# ------------------------------------------------------------------------------
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# DEPLOYMENT FRONTEND URL
# Set this in Render if your frontend is served from a custom domain
# e.g. https://mass-booking.youngandchosenforchrist.com
# ------------------------------------------------------------------------------
FRONTEND_URL=
